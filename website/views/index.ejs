<!DOCTYPE html>
<html lang="en" id="htmlRoot">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#090a0d">
  <meta name="description" content="DENTSU PROJECT BOT — connexion WhatsApp par code de jumelage.">
  <title><%= botName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="ambient ambient-one"></div>
  <div class="ambient ambient-two"></div>
  <div class="noise"></div>

  <main class="shell" id="mainContent">
    <header class="topbar">
        <a class="brand" href="/" aria-label="DENTSU PROJECT BOT home">
        <span class="brand-icon"><img src="<%= menuImage %>" alt=""></span>
        <span class="brand-copy"><strong><%= botName %></strong><small>NATSU GRADNIGR / BOT LAB</small></span>
      </a>
      <div class="top-actions">
          <span class="live-pill" id="livePill"><i class="pulse-dot"></i><span data-i18n="live">Système en ligne</span></span>
      </div>
    </header>

    <section class="hero">
      <div class="hero-copy">
        <span class="eyebrow"><span class="eyebrow-line"></span> NATSU GRADNIGR / WHATSAPP BOT</span>
        <h1><%= botName %><br><span>by <%= devName %></span></h1>
        <p class="hero-lede">Un bot WhatsApp rapide, stable et pensé pour connecter ton numéro en quelques secondes.</p>
        <div class="hero-meta">
          <span><b class="meta-dot"></b><span data-i18n="secure">Connexion sécurisée</span></span>
          <span><b>50</b> <span data-i18n="multi">sessions disponibles</span></span>
        </div>
      </div>
      <div class="hero-visual">
        <div class="visual-halo"></div>
        <div class="visual-ring ring-a"></div>
        <div class="visual-ring ring-b"></div>
        <img src="<%= menuImage %>" alt="<%= botName %> artwork" class="bot-image">
        <div class="visual-strip" aria-label="DENTSU PROJECT BOT artwork">
          <% (menuImages || []).forEach((image, index) => { %><img src="<%= image %>" alt="Bot artwork <%= index + 1 %>"><% }) %>
        </div>
        <div class="visual-tag tag-top"><span class="tag-dot"></span> ONLINE</div>
        <div class="visual-tag tag-bottom"><span>WA</span> PRÊT À CONNECTER</div>
      </div>
    </section>

    <section class="dashboard-grid">
      <div class="pair-card panel whatsapp-frame">
        <div class="panel-heading">
          <div>
            <span class="step-label">01 / WHATSAPP</span>
            <h2 data-i18n="h2_connect">📱 Connecter WhatsApp</h2>
          </div>
          <span class="panel-number">01</span>
        </div>
        <p class="subtitle" data-i18n="subtitle_connect">Enter your number with the country code to receive a secure pairing code.</p>

        <form id="pairForm">
          <label for="number" class="field-label" data-i18n="number_label">WhatsApp number</label>
          <div class="input-group">
            <span class="input-prefix">+</span>
            <input type="tel" id="number" placeholder="242 06 12 34 56" maxlength="15" autocomplete="off" inputmode="numeric" aria-describedby="numberHint">
            <span class="input-status">WA</span>
          </div>
          <p class="hint" id="numberHint" data-i18n="hint">Include the country code without +. Example: <strong>242</strong>XXXXXXXX</p>
          <button id="pairBtn" type="submit" data-i18n="btn_pair"><span>Get my pairing code</span><b>↗</b></button>
        </form>

        <div id="result" style="display:none;" class="result"></div>

        <div id="codeDisplay" style="display:none;" class="code-box">
          <div class="code-topline"><span class="step-label">PAIRING CODE</span><span class="code-live"><i class="pulse-dot"></i> LIVE</span></div>
          <p class="code-label" data-i18n="code_label">Your pairing code</p>
          <div class="code-value" id="codeValue"></div>
          <button id="copyBtn" class="copy-btn" data-i18n="btn_copy">Copy code <span>⌘ C</span></button>
        </div>

        <div id="steps" style="display:none;" class="steps-box">
          <div class="steps-heading"><span class="step-label">02 / FINISH</span><h3 data-i18n="steps_title">Enter the code in WhatsApp</h3></div>
          <ol id="stepsList"></ol>
          <div class="warning-box" data-i18n="warning">The code expires in <strong>60 seconds</strong>.</div>
        </div>
      </div>

      <aside class="side-column">
        <div class="guide-card panel">
          <span class="step-label">QUICK GUIDE</span>
          <h3 data-i18n="guide_title">How it works</h3>
          <div class="guide-item"><span>01</span><p data-i18n="guide_one">Enter your number with the country code.</p></div>
          <div class="guide-item"><span>02</span><p data-i18n="guide_two">Receive your unique pairing code.</p></div>
          <div class="guide-item"><span>03</span><p data-i18n="guide_three">Confirm it in Linked Devices.</p></div>
        </div>

        <div class="social-card panel developer-card">
          <span class="step-label">STAY CONNECTED</span>
          <div class="developer-line"><span class="developer-mark">NT</span><div><strong><%= devName %></strong><small>Développeur · +<%= devNumber %></small></div></div>
          <div class="social-links">
       <% if (groupLink) { %><a href="<%= groupLink %>" target="_blank" rel="noreferrer" class="social-btn group-btn"><span>GR</span><b data-i18n="social_group">WhatsApp group</b><i>↗</i></a><% } %>
            <% if (telegram) { %><a href="<%= telegram %>" target="_blank" rel="noreferrer" class="social-btn telegram-btn"><span>TG</span><b>Telegram</b><i>↗</i></a><% } %>
              <% if (website) { %><a href="<%= website %>" target="_blank" rel="noreferrer" class="social-btn website-btn"><span>WEB</span><b data-i18n="social_website">Official website</b><i>↗</i></a><% } %>
          </div>
        </div>
      </aside>
    </section>

    <footer class="footer">
      <span>© 2026 <%= botName %></span><span class="footer-separator">/</span><span>créé par <strong><%= devName %></strong></span>
       <span class="footer-version">NATSU GRADNIGR / ONLINE</span>
    </footer>
  </main>

  <script src="/app.js"></script>
</body>
</html>